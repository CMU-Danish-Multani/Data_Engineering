# Template for the project's environment file. No real secrets here.
#
# Copy to:  src/stock_db/alembic_migration/.env
# Every loader and Alembic read that one path. Variables already set in the
# shell take precedence over this file. URL-encode special characters in
# passwords (for example @ -> %40, # -> %23, / -> %2F).

# PostgreSQL on AWS RDS. Read by Alembic and every loader.
# HOST is the RDS endpoint, e.g. <instance>.<id>.us-east-1.rds.amazonaws.com
# The driver prefix postgresql+psycopg:// is required (psycopg 3 is installed).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/stock_intelligence?sslmode=require

# MongoDB Atlas. Read by sec_companyfacts.py and the metric loaders.
# Database name defaults to stock_intelligence when the URI omits it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/stock_intelligence?retryWrites=true&w=majority

# SEC requires a descriptive User-Agent with a contact email on every request
# (data.sec.gov and www.sec.gov). Requests without it are rejected.
SEC_USER_AGENT="CMU Team 8 Stock Intelligence CONTACT_EMAIL"

# AWS. Not read by any project code today: the S3 data lake was dropped, and
# RDS is reached only through DATABASE_URL above. Keep these only for the AWS
# CLI or console scripts (for example looking up the RDS endpoint).
# AWS_PROFILE=default
# AWS_REGION=us-east-1
